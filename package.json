{
  "name": "caraveso",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:server": "tsx --test server/test/*.test.ts",
    "test:integration": "npm run build:server && node server/test/integration-smoke.cjs",
    "start:customer": "ng serve customer-web --proxy-config proxy.conf.json",
    "start:admin": "ng serve admin-web --port 4201 --proxy-config proxy.conf.json",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:worker": "tsx watch server/src/worker.ts",
    "dev:redis": "mkdir -p $HOME/.local/var/redis && $HOME/.local/bin/redis-server --daemonize yes --port 6379 --bind 127.0.0.1 --dir $HOME/.local/var/redis --save \"\" --appendonly no --logfile $HOME/.local/var/redis/redis.log",
    "seed": "tsx server/seed/seed.ts",
    "bank:simulate": "tsx server/scripts/simulate-bank-transfer.ts",
    "test:server": "tsx --test \"server/**/*.test.ts\"",
    "test:web": "tsx --test \"projects/customer-web/**/*.spec.ts\"",
    "start:api": "node dist/server/src/server.js",
    "start:worker": "node dist/server/src/worker.js",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "ng build customer-web && ng build admin-web",
    "seed:roles": "tsx server/seed/roles.ts",
    "test:auth": "vitest run"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/router": "19.2.25",
    "@types/three": "0.180.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "ng-packagr": "19.2.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "resend": "^6.34.1",
    "rxjs": "~7.8.0",
    "three": "0.180.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "19.2.27",
    "@angular/cli": "19.2.27",
    "@angular/compiler-cli": "19.2.25",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.8.3",
    "vitest": "^5.0.5"
  }
}
